[
    {
        "name": "log",
        "what_it_does": "Writes message to console using console.log",
        "parameters": "message",
        "example_usage": [
            "log(`Hello World!`)"
        ]
    },
    {
        "name": "logWarning",
        "what_it_does": "Writes warning to console using console.warn",
